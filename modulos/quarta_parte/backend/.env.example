# MongoDB Atlas (vazio = repositório em memória). Aceita também MONGODB_URI / MONGODB_DB.
MONGO_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGO_DB=cartorio_db

# Defina a chave de um dos provedores. LLM_PROVIDER (gemini | openai | heuristic) só é
# necessário se as duas chaves estiverem preenchidas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelos tentados em ordem se o principal estiver sobrecarregado (503/429)
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=gemini

# Separe várias origens por vírgula
CORS_ORIGINS=http://localhost:4210

AREA_TOLERANCE_PERCENT=5
DEFAULT_UTM_ZONE=23
