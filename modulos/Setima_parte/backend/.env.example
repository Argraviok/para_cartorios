# MongoDB Atlas (vazio = repositório em memória, apenas desenvolvimento)
MONGODB_URI=mongodb://localhost:27021
MONGODB_DB=cartorio_lgpd

STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# Detecção contextual por LLM: none | gemini | openai
# ATENÇÃO: gemini/openai enviam o texto integral do documento ao provedor (transferência
# internacional de dados, LGPD art. 33). Exige base legal e contrato (DPA) com o provedor.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Remove do MongoDB o texto detectado após a sanitização
PURGE_DETECTED_TEXT_ON_FINALIZE=true

CORS_ORIGINS=["http://localhost:4200"]
