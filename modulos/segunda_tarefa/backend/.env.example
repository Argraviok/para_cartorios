# Banco — Atlas: mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# Local (docker mongodb/mongodb-atlas-local): mongodb://localhost:27018/?directConnection=true
MONGO_URI=mongodb://localhost:27018/?directConnection=true
MONGO_DB=cartorio_db

# Defina a chave de um dos provedores. LLM_PROVIDER (gemini | openai | offline) só é
# necessário se as duas chaves estiverem preenchidas. offline = sem IA, usa só a redação-modelo das fichas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Usados em ordem quando o modelo principal estiver sobrecarregado (503/429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=gemini

# Embeddings: seguem o provedor do LLM (gemini-embedding-001 / text-embedding-3-small).
# Para fixar: EMBEDDING_PROVIDER / EMBEDDING_MODEL. Dimensão fixa; trocar exige scripts.reindex_embeddings
EMBEDDING_DIMS=768

# Serventia
SERVENTIA_NOME=Oficial de Registro de Imóveis da Comarca de Exemplo
SERVENTIA_CNS=00.000-0
SERVENTIA_ENDERECO=Rua Exemplo, 100 — Centro
SERVENTIA_CIDADE_UF=Exemplo/SP
OFICIAL_NOME=Nome do Oficial
# Confirmar com a redação vigente do art. 205 da LRP e as normas da CGJ local
PRENOTACAO_DIAS=20

# Separadas por vírgula
CORS_ORIGINS=http://localhost:4240
