# Banco: sem MONGODB_URI a API usa um repositório em memória (dados se perdem ao reiniciar)
MONGODB_URI=
MONGODB_DB=cartorio_triagem

# IA: defina a chave de um dos provedores. Sem nenhuma, o diálogo usa regras locais
# e as fotos vão para conferência manual do escrevente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=gemini   # auto | gemini | openai | heuristic

OFFICE_NAME=Cartório de Notas
OFFICE_STATE=SP
DEMO_DATA=true
CORS_ORIGINS=http://localhost:4220
